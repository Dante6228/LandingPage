---
import BaseLayout from '../layouts/BaseLayout.astro';
import Dust from '../components/Dust.astro';
import AudioToggle from '../components/AudioToggle.astro';
import YouTubeFacade from '../components/YouTubeFacade.astro';
import Bandsintown from '../components/Bandsintown.astro';
import Newsletter from '../components/Newsletter.astro';
import Shop from '../components/Shop.astro';
import { Image, Picture, getImage } from 'astro:assets';
import { artist, platforms, dreaming, liveSessions, latestRelease, vinyl, socials } from '../data/site';
import { IDS, SITE, absoluteUrl, albumNode, artistNode, latestReleaseNode, liveSessionNodes, personRef } from '../data/seo';

import profileImg from '../assets/img/Profile.jpg';
import dreamingImg from '../assets/img/dreaming.jpg';
import cover4Img from '../assets/img/Cover4.jpg';
import vinylImg from '../assets/img/Vinyl2.png';
import appleMusicIcon from '../assets/ico/AppleMusic.png';
import youtubeMusicIcon from '../assets/ico/youtubeMusic.png';

const icons: Record<string, ImageMetadata> = { 'AppleMusic.png': appleMusicIcon, 'youtubeMusic.png': youtubeMusicIcon };

// Fondo: la misma foto, difuminada al 25 % de opacidad. Basta una versión ligera.
const background = await getImage({ src: profileImg, width: 1600, format: 'webp', quality: 60 });
// Copia difuminada detrás de la portada de Dreaming (blur-3xl): no necesita resolución.
const dreamingGlow = await getImage({ src: dreamingImg, width: 200, format: 'webp', quality: 50 });
// Versiones absolutas para los datos estructurados y la vista previa social.
const profileAbs = absoluteUrl((await getImage({ src: profileImg, width: 800, format: 'jpg' })).src);
const dreamingAbs = absoluteUrl((await getImage({ src: dreamingImg, width: 1200, format: 'jpg' })).src);
const cover4Abs = absoluteUrl((await getImage({ src: cover4Img, width: 1200, format: 'jpg' })).src);

const profilePage = {
  '@type': 'ProfilePage',
  '@id': `${SITE}/#perfil`,
  url: `${SITE}/`,
  name: 'Alen Jeynrod | Pianist & Composer',
  inLanguage: 'es-MX',
  isPartOf: { '@id': IDS.website },
  mainEntity: { '@id': IDS.artist },
  primaryImageOfPage: { '@type': 'ImageObject', url: profileAbs },
  hasPart: [{ '@id': IDS.album }, { '@type': 'WebPage', '@id': `${SITE}/gallery#webpage`, url: `${SITE}/gallery`, name: 'Dreaming | The Experience Hub' }],
};
---

<BaseLayout
  title="Alen Jeynrod | Pianist & Composer"
  description="Página oficial de Alen Jeynrod, pianista y compositor. Escucha su último sencillo 'A Reason More To Smile' y adquiere partituras oficiales."
  ogType="profile"
  bodyClass="font-body antialiased bg-warm-black text-cream selection:bg-orange-900/30 selection:text-cream overflow-x-hidden"
  jsonLd={[profilePage, artistNode(profileAbs), personRef(), albumNode(dreamingAbs), latestReleaseNode(cover4Abs), ...liveSessionNodes()]}
>
  <div
    class="fixed inset-0 w-full h-full bg-cover bg-center opacity-25 -z-20 sepia-[.6] brightness-75 contrast-110 blur-[2px] animate-breathe"
    style={`background-image:url('${background.src}')`}
    aria-hidden="true"
  >
  </div>
  <div class="fixed inset-0 w-full h-full bg-noise opacity-5 -z-10 pointer-events-none" aria-hidden="true"></div>
  <div class="fixed inset-0 w-full h-full bg-vignette -z-10 pointer-events-none" aria-hidden="true"></div>

  <Dust />
  <AudioToggle />

  <main id="contenido" class="min-h-screen flex flex-col items-center py-20 px-4 sm:px-6">
    <section class="text-center mb-14 relative" data-aos="fade-down" data-aos-duration="1200">
      <div class="relative inline-block group">
        <Picture
          src={profileImg}
          formats={['avif', 'webp']}
          widths={[128, 256]}
          sizes="128px"
          alt={artist.name}
          loading="eager"
          fetchpriority="high"
          class="w-32 h-32 rounded-full object-cover border border-white/5 shadow-2xl transition duration-700 ease-out opacity-90 group-hover:opacity-100"
        />
        <div class="absolute inset-0 rounded-full bg-orange-500/10 blur-2xl -z-10 scale-110"></div>
      </div>

      <h1 class="text-5xl md:text-6xl text-cream font-display font-light mt-6 tracking-wide italic">
        {artist.name}
      </h1>
      <h2 class="text-cream-dim mt-3 font-light text-xs tracking-[0.2em] uppercase border-t border-white/10 pt-3 inline-block px-4">
        {artist.role}
      </h2>
    </section>

    <div class="w-full max-w-md grid grid-cols-1 gap-3 mb-24" data-aos="fade-up" data-aos-delay="100">
      <a
        href={platforms.spotify.url}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-glass-bg backdrop-blur-2xl border border-glass-border shadow-glass rounded-xl p-4 flex items-center gap-4 group transition-all duration-500 hover:bg-[#fff0dc]/10 hover:-translate-y-0.5 hover:border-[#ffe6c8]/15"
        aria-label="Escuchar en Spotify"
      >
        <img src={platforms.spotify.icon} class="w-7 opacity-90 group-hover:opacity-100 transition" alt="" width="28" height="28" />
        <span class="text-cream group-hover:text-white font-light tracking-wide flex-1">{platforms.spotify.label}</span>
        <svg class="w-4 h-4 text-cream-dim group-hover:text-cream transform group-hover:translate-x-1 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>

      <div class="grid grid-cols-2 gap-3">
        {platforms.secondary.map((p) => (
          <a
            href={p.url}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-glass-bg backdrop-blur-2xl border border-glass-border shadow-glass rounded-xl p-3 flex flex-col items-center gap-2 text-center transition-all duration-500 hover:bg-[#fff0dc]/10 hover:-translate-y-0.5 hover:border-[#ffe6c8]/15"
          >
            <Image src={icons[p.icon]} width={48} height={48} format="webp" class="w-6 h-auto opacity-80" alt="" />
            <span class="text-xs text-cream-dim">{p.label}</span>
          </a>
        ))}
      </div>

      <div class="flex justify-center gap-6 mt-4 opacity-50 hover:opacity-90 transition duration-500">
        {platforms.minor.map((p) => (
          <a href={p.url} target="_blank" rel="noopener noreferrer" title={p.label} class="inline-flex items-center justify-center min-w-6 min-h-6">
            <img src={p.icon} class="w-5 filter invert grayscale" alt={p.alt} width="20" height="20" />
          </a>
        ))}
      </div>
    </div>

    <section class="w-full max-w-4xl px-4 mb-24" data-aos="fade-up">
      <div class="text-center mb-10">
        <span class="text-xs tracking-[0.3em] text-cream-dim uppercase">{dreaming.kicker}</span>
        <h2 class="text-4xl md:text-5xl font-display italic text-cream mt-2">{dreaming.title}</h2>
        <div class="w-px h-12 bg-gradient-to-b from-cream/50 to-transparent mx-auto mt-6"></div>
      </div>

      <div class="flex flex-col md:flex-row gap-10 items-start">
        <div class="w-full md:w-1/3 flex flex-col gap-6">
          <div class="relative group w-full">
            <img
              src={dreamingGlow.src}
              aria-hidden="true"
              alt=""
              width="200"
              height="200"
              loading="eager"
              decoding="async"
              class="absolute top-4 left-0 w-full h-full object-cover blur-3xl saturate-200 transition duration-1000 group-hover:opacity-80 group-hover:scale-105 -z-10"
            />
            <Picture
              src={dreamingImg}
              formats={['avif', 'webp']}
              widths={[320, 480, 640, 960]}
              sizes="(min-width: 896px) 266px, (min-width: 768px) 30vw, calc(100vw - 4rem)"
              alt="Dreaming Album Art"
              loading="lazy"
              class="relative z-10 w-full h-auto rounded-lg shadow-[0_20px_50px_rgba(0,0,0,0.5)] border border-white/5 opacity-90 hover:opacity-100 transition duration-700"
            />
          </div>

          <div class="bg-glass-bg backdrop-blur-md border border-glass-border p-6 rounded-xl relative z-10">
            <h3 class="font-display text-xl text-cream mb-2">{dreaming.conceptTitle}</h3>
            <p class="text-sm text-cream-dim font-light leading-relaxed text-justify">{dreaming.concept}</p>
          </div>
        </div>

        <div class="w-full md:w-2/3 flex flex-col gap-3">
          <h3 class="font-display text-lg text-cream/60 mb-2 italic text-right px-2">{dreaming.memoriesTitle}</h3>

          {dreaming.tracks.map((t) => (
            <details class="group bg-glass-bg border border-glass-border rounded-xl open:bg-white/5 transition-all duration-500">
              <summary class="flex items-center justify-between p-4 cursor-pointer list-none">
                <div class="flex items-center gap-4">
                  <span class="text-xs text-cream/60 font-mono">{t.n}</span>
                  <span class="text-cream font-display text-lg group-hover:pl-2 transition-all duration-300">{t.title}</span>
                </div>
                <span class="text-cream/40 group-open:rotate-45 transition-transform duration-300 text-xl font-light" aria-hidden="true">+</span>
              </summary>
              <div class="px-4 pb-6 pt-2 text-sm text-cream-dim font-light leading-relaxed border-t border-white/5 mx-4 mt-2">
                <p>{t.memory}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="w-full max-w-6xl mb-24 px-4 overflow-hidden" data-aos="fade-up">
      <div class="flex items-center gap-4 mb-8 px-2 max-w-4xl mx-auto">
        <h2 class="text-2xl text-cream font-display italic">Live Sessions</h2>
        <div class="h-[1px] bg-white/10 flex-1"></div>
        <span class="text-xs text-cream/40 animate-pulse block md:hidden">← Desliza →</span>
      </div>

      <div class="video-scroll flex gap-6 overflow-x-auto snap-x snap-mandatory pb-12 px-4 md:px-[calc(50%-20rem)]">
        {liveSessions.map((v) => (
          <div class="min-w-[85vw] md:min-w-[40rem] snap-center bg-glass-bg backdrop-blur-2xl border border-glass-border shadow-glass p-2 rounded-xl transition duration-500">
            <div class="relative w-full aspect-video rounded-xl overflow-hidden bg-[#1a1512]">
              <YouTubeFacade id={v.id} title={v.iframeTitle} />
            </div>
            <div class="p-4 flex justify-between items-end">
              <div>
                <h3 class="text-xl font-display text-cream">{v.title}</h3>
                <p class="text-xs text-cream-dim font-body mt-1">{v.subtitle}</p>
              </div>
              <span class="text-xs text-cream/30 font-mono">{v.n}</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="relative w-full max-w-4xl mb-24 flex flex-col md:flex-row items-center justify-center gap-8 md:gap-12" data-aos="zoom-in">
      <div class="absolute inset-0 bg-orange-900/10 blur-3xl rounded-full -z-10"></div>

      <Picture
        src={cover4Img}
        formats={['avif', 'webp']}
        widths={[256, 512]}
        sizes="256px"
        alt={latestRelease.coverAlt}
        loading="lazy"
        class="w-64 h-auto shadow-[0_20px_50px_rgba(0,0,0,0.5)] rounded-xs hover:scale-105 transition duration-700 ease-out border border-white/5"
      />

      <div class="text-center md:text-left max-w-xs">
        <span class="text-xs tracking-widest text-orange-200/50 uppercase">{latestRelease.kicker}</span>
        <h2 class="text-3xl md:text-4xl font-display italic text-cream mt-2 mb-4 leading-tight">{latestRelease.title}</h2>
        <p class="text-sm text-cream-dim font-light leading-relaxed mb-6">{latestRelease.text}</p>
        <a
          href={latestRelease.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block px-6 py-2 border border-cream/20 rounded-full text-xs text-cream hover:bg-cream hover:text-black transition duration-300"
        >
          {latestRelease.cta}
        </a>
      </div>
    </section>

    <section class="w-full max-w-4xl mb-24 px-4" data-aos="fade-up">
      <div class="relative backdrop-blur-xl border border-[#d37e74]/20 shadow-glass rounded-2xl p-6 md:p-10 flex flex-col md:flex-row items-center gap-8 overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-br from-[#e28b78] via-[#c47161] via-[#427370] to-[#93cba8] opacity-40 -z-10"></div>
        <div class="absolute inset-0 bg-gradient-to-tr from-[#327a76]/50 via-[#a97c79]/40 to-[#f38d76]/50 -z-10"></div>
        <div class="absolute inset-0 bg-gradient-to-bl from-[#cfe0b3]/30 via-transparent to-[#42887f]/40 -z-10"></div>

        <div class="w-full md:w-2/5 flex items-center justify-center">
          <div class="relative group w-full max-w-[280px]">
            <div class="relative aspect-auto w-full overflow-hidden">
              <Picture
                src={vinylImg}
                formats={['avif', 'webp']}
                widths={[280, 560]}
                sizes="280px"
                alt={vinyl.imageAlt}
                loading="lazy"
                class="w-full h-full bg-transparent object-cover opacity-90 group-hover:opacity-100 transition duration-700"
              />
            </div>
          </div>
        </div>

        <div class="w-full md:w-3/5 text-center md:text-left">
          <span class="text-xs tracking-[0.3em] text-cream-dim uppercase">{vinyl.kicker}</span>
          <h2 class="text-3xl md:text-4xl font-display italic text-cream mt-2">{vinyl.title}</h2>
          <p class="text-sm text-cream-dim font-light leading-relaxed mt-4">{vinyl.text}</p>
          <div class="mt-6 flex flex-col sm:flex-row gap-3 sm:items-center">
            <a
              href={vinyl.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 px-6 py-2 rounded-full bg-cream text-warm-black text-xs tracking-widest uppercase hover:shadow-[0_8px_30px_rgba(255,230,200,0.35)] transition"
            >
              {vinyl.cta}
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="w-full max-w-2xl text-center mb-24 px-4">
      <h2 class="text-3xl text-cream font-display mb-8 italic" data-aos="fade-up">El Artista</h2>
      <div class="bg-glass-bg backdrop-blur-2xl border border-glass-border shadow-glass rounded-2xl p-8 md:p-12 text-cream-dim leading-relaxed space-y-6 text-sm md:text-base font-light text-justify relative overflow-hidden">
        <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-orange-500/20 to-transparent"></div>

        <p data-aos="fade-up">
          <span class="text-4xl float-left mr-3 mt-[-8px] font-display text-cream opacity-80">M</span>i viaje musical
          comenzó con la batería, pero encontré mi verdadera pasión en el silencio entre las teclas del piano.
          Mi estilo está fuertemente influenciado por la nostalgia de <em>Chopin</em> y las texturas modernas del <em>lofi</em>; mi
          música busca ser un refugio.
        </p>
        <p data-aos="fade-up">
          Actualmente me encuentro trabajando en <strong>"Dreaming"</strong>, mi primer álbum de puro piano e instrumentación de cuerdas, creado
          para acompañar esos momentos de soledad y reflexión.
        </p>
        <div class="flex justify-center pt-4">
          <span class="text-2xl text-orange-200/20" aria-hidden="true">❧</span>
        </div>
      </div>
    </section>

    <Newsletter />
    <Shop />

    <footer class="w-full max-w-2xl flex flex-col items-center gap-10 pb-12 border-t border-white/5 pt-12">
      <div class="flex items-center gap-10">
        {socials.map((s) => (
          <a href={s.url} target="_blank" rel="noopener noreferrer me" class="opacity-40 hover:opacity-100 hover:scale-110 transition duration-300" aria-label={s.label}>
            <img src={s.icon} class="h-6 w-auto" alt={s.label} width="24" height="24" />
          </a>
        ))}
      </div>

      <Bandsintown />

      <!-- Contraste: antes text-white/20 (1.8:1, ilegible); /50 cumple AA sin cambiar el carácter -->
      <p class="text-xs text-white/50 mt-4 tracking-widest">© 2026 Alen Jeynrod.</p>
    </footer>
  </main>
</BaseLayout>
